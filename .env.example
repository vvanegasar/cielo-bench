# cielo-bench: local settings for real runs.
# Copy this file to .env (git-ignored) and fill it with PERSONAL keys only.
# The harness reads ONLY variables that start with CIELO_, from this file or from the
# environment. Generic names such as ANTHROPIC_API_KEY or OPENAI_API_KEY are ignored on
# purpose, so a key exported for another account can never be used by mistake.

# Models for `cielo-bench run` (comma-separated). A spec is provider[:model-id]:
#   anthropic[:id]  openai[:id]  openrouter[:id]  ollama[:id]  compat[:id]
# Pin versions: use dated snapshot ids where the provider offers them.
CIELO_MODELS=anthropic,openai

# Hard stop for a real run, in USD (estimated from API usage and the prices below).
CIELO_MAX_USD=10

# --- Anthropic (Messages API) ------------------------------------------------------
CIELO_ANTHROPIC_API_KEY=
CIELO_ANTHROPIC_MODEL=claude-opus-5-5
# Optional: output_config.effort (low | medium | high | xhigh | max). Empty = model default.
CIELO_ANTHROPIC_EFFORT=
CIELO_ANTHROPIC_MAX_TOKENS=16000
CIELO_ANTHROPIC_RPM=50
# Built-in list prices exist for current Claude models; override only if they change.
CIELO_ANTHROPIC_PRICE_IN_PER_MTOK=
CIELO_ANTHROPIC_PRICE_OUT_PER_MTOK=

# --- OpenAI (Chat Completions) -----------------------------------------------------
CIELO_OPENAI_API_KEY=
CIELO_OPENAI_MODEL=
CIELO_OPENAI_MAX_TOKENS=
CIELO_OPENAI_REASONING_EFFORT=
CIELO_OPENAI_RPM=60
# Required for the budget guard: USD per million tokens, from the provider's pricing page.
CIELO_OPENAI_PRICE_IN_PER_MTOK=
CIELO_OPENAI_PRICE_OUT_PER_MTOK=

# --- OpenRouter (OpenAI-compatible) -------------------------------------------------
CIELO_OPENROUTER_API_KEY=
CIELO_OPENROUTER_MODEL=
CIELO_OPENROUTER_RPM=20
CIELO_OPENROUTER_PRICE_IN_PER_MTOK=
CIELO_OPENROUTER_PRICE_OUT_PER_MTOK=

# --- Ollama (local, no key, no cost) -------------------------------------------------
CIELO_OLLAMA_BASE_URL=http://localhost:11434/v1
CIELO_OLLAMA_MODEL=

# --- Any other OpenAI-compatible endpoint (spec: compat[:id]) -----------------------
CIELO_OPENAI_COMPAT_API_KEY=
CIELO_OPENAI_COMPAT_BASE_URL=
CIELO_OPENAI_COMPAT_MODEL=
CIELO_OPENAI_COMPAT_MAX_TOKENS_PARAM=max_tokens
CIELO_OPENAI_COMPAT_PRICE_IN_PER_MTOK=
CIELO_OPENAI_COMPAT_PRICE_OUT_PER_MTOK=

# --- Upstream sources ---------------------------------------------------------------
# Optional: override the User-Agent sent to JPL Horizons (keep it free of personal data).
# CIELO_USER_AGENT=cielo-bench/0.1.0 (non-commercial research benchmark)
# Optional: a PEM bundle for TLS verification (default: certifi).
# CIELO_CA_BUNDLE=
